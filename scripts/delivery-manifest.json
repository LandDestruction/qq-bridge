{
  "version": 1,
  "packageName": "qq-bot-system",
  "doc": "交付包唯一真源（include / exclude / redact / optional）。build-delivery.mjs 只读这一份；不要在脚本里硬编码第二份名单。",
  "include": [
    { "from": "src" },
    { "from": "scripts" },
    { "from": "scripts/verify-rebuild.mjs" },
    { "from": "public" },
    { "from": "desktop" },
    { "from": "assets" },
    { "from": "dsh" },
    { "from": "plugins" },
    { "from": "roles" },
    { "from": "docs" },
    { "from": "delivery/ops", "to": "ops" },
    { "from": "delivery/dsh", "to": "dsh" },
    { "from": "delivery/persona", "to": "persona" },
    { "from": "delivery/specs", "to": "docs/specs" },
    { "from": "package.json" },
    { "from": "package-lock.json" },
    { "from": "config.example.json" },
    { "from": "config.template.json" },
    { "from": "build-installer.ps1" },
    { "from": "README.md" },
    { "from": "README.en.md" },
    { "from": "README-COMMANDS.md" },
    { "from": "RULES.md" },
    { "from": "LICENSE" },
    { "from": "build-installer.ps1" },
    { "from": "start.bat" },
    { "from": "restart.bat" },
    { "from": "start-bridge-forever.bat" },
    { "from": "_snowluma-catalog.json" }
  ],
  "exclude": {
    "dirsAnywhere": ["state", "logs", "dist", ".git", "node_modules", "__pycache__", ".npm-cache", ".venv"],
    "paths": [
      "scripts/build-full-bundle.ps1",
      "roles/肉便器.md",
      "docs/archive-audit.md",
      "docs/archive-repair-plan.md",
      "docs/audits",
      "docs/design",
      "docs/legacy",
      "docs/research",
      "docs/qq-bridge-PUBLISH_PLAN.md",
      "docs/qq-bridge-SECURITY_AUDIT.md",
      "docs/guides/PROJECT_GUIDE.md",
      "docs/guides/VOICE.md",
      "desktop/vendor"
    ],
    "nameGlobs": ["*.log", "*.bak*", ".env", ".env.*", "*.pyc", "*.exe", "privacy-rules.json", "config.json", "handoff-*.md", "CHANGELOG-COMMITS.md", "FIXES.md", "fix-batch-*.md", "tone-eval-*.json", "research-booth-konoasset.md", "booth-library-manager-reverse.md", "pack-project.ps1", "pack-project-full.ps1", "test-pack-exclude.mjs"],
    "rootGlobs": ["*.py", "PROJECT_GUIDE.md", "ARCH_REVIEW.md", "DSH_QQ_TOOLS_PLAN.md", "GEN2_SIMULATION_PLAN.md", "SOCIAL_MODE_PLAN.md", "RESEARCH_QQ_MESSAGE_DND.md", "RESEARCH_SNOWLUMA_EMOJI_STICKER.md", "SnowLuma功能调研.md", "真人语感策略.md", "TOKEN_COST.md", "LOCAL_MODEL_SIZING.md"]
  },
  "optional": {
    "audio": {
      "dirs": ["audio"],
      "why": "本地音频/人声素材，可能含群友声音，默认不带；-Full 才带，并由使用者自行判断"
    },
    "node_modules": {
      "dirs": ["node_modules"],
      "why": "依赖体积约 21 MB；默认让使用者 npm install 恢复，-Full 才带（离线机器用）"
    }
  },
  "stateWhitelist": {
    "note": "state/ 的**唯一白名单例外**（用户 2026-10-27 12:59 拍板：表情库默认带）。其余 state/ 依旧全剥。只允许这两个路径，且 stickers.json 的字段级脱敏由 build-delivery 处理（collectedBy→<群友>，collectedContext/lastContext 清空，source/collectedFrom 的群号→<群号>；id/resId/emojiId/md5/dhash/url/fileid/spec/policy/thumbStatus/useCount/时间戳原样保留，删了表情就发不出去）。",
    "paths": [
      "scripts/build-full-bundle.ps1","state/stickers.json", "state/sticker-files"]
  },
  "redact": {
    "extensions": [".md", ".js", ".mjs", ".cjs", ".json", ".yml", ".yaml", ".ps1", ".cmd", ".bat", ".txt", ".tsv", ".html", ".css", ".py"],
    "patterns": [
      { "name": "windows-user-path", "regex": "[A-Za-z]:\\\\Users\\\\[^\\\\\\s\"'`]{2,}", "replace": "<本机路径>" },
      { "name": "windows-users-bare", "regex": "[A-Za-z]:\\\\Users(?![\\\\a-zA-Z0-9])", "replace": "<本机路径>" },
      { "name": "windows-abs-path", "regex": "(?<![A-Za-z0-9])[A-Za-z]:\\\\(?!Users)[^\\\\\\s\"'`|<>]{2,}\\\\", "replace": "<本机路径>\\" },
      { "name": "api-key-sk", "regex": "sk-[A-Za-z0-9_-]{16,}", "replace": "<API_KEY>" },
      { "name": "bearer-token", "regex": "Bearer\\s+[A-Za-z0-9_.-]{20,}", "replace": "Bearer <TOKEN>" }
    ],
    "dynamicLiterals": {
      "note": "从 --config 指向的真实 config.json 读取这些字段的值，在全包文本里替换成占位符；构建机的真实 QQ/群号/令牌不会被带进包。",
      "fromConfig": ["ownerQQ", "allow.private", "allow.groups", "snowluma.accessToken", "consoleToken", "dsh.authToken"],
      "replaceWith": { "ownerQQ": "<QQ号>", "allow.private": "<QQ号>", "allow.groups": "<群号>", "snowluma.accessToken": "<SNOWLUMA_ACCESS_TOKEN>", "consoleToken": "<CONSOLE_TOKEN>", "dsh.authToken": "<DSH_LAUNCH_TOKEN>" }
    },
    "knownLiterals": [
      { "literal": "100000007", "replace": "<机器人QQ号>", "why": "线上机器人的 QQ 号（出现在 CHANGELOG）" },
      { "literal": "100000005", "replace": "<群号>", "why": "某一版白名单群号（api-contract 文档示例）" }
    ],
    "allowNumbers": {
      "725000": "MCP 工具超时预算 toolCallTimeoutMs（毫秒常量，不是群号）",
      "600000": "silenceWarnMs 默认值（毫秒）",
      "300000": "questionTimeoutMs 默认值（毫秒）",
      "200000": "等待配置常量（毫秒）",
      "1000000": "窗口/令牌上限常量",
      "11434": "ollama 默认端口",
      "8791": "STT 服务默认端口",
      "20261026": "日期戳 yyyyMMdd",
      "20261027": "日期戳 yyyyMMdd",
      "120000": "毫秒常量（2 分钟）",
      "180000": "毫秒常量（3 分钟）",
      "900000": "毫秒常量（15 分钟）",
      "1800000": "毫秒常量（30 分钟）",
      "2700000": "毫秒常量（45 分钟）",
      "3600000": "毫秒常量（1 小时）",
      "5400000": "毫秒常量（90 分钟）",
      "7200000": "毫秒常量（2 小时）",
      "86400000": "毫秒常量（1 天）",
      "1048576": "字节数（1 MiB）",
      "2097152": "字节数（2 MiB）",
      "5242880": "字节数（5 MiB）",
      "204800": "字节数（200 KiB）",
      "41943040": "字节数（40 MiB）",
      "2000000": "上限常量",
      "123456789": "首启提示示例里的占位群号（delivery/persona/initial-prompts.example.json）",
      "100000000": "安装器占位 ownerQQ（post-install.ps1 未传 /owner= 时的默认值，非真实账号）",
      "100000001": "安装器测试用占位 ownerQQ（demo-install.ps1 的 /owner= 示例参数，非真实账号）",
      "420000": "毫秒常量（7 分钟，config.example）",
      "360000": "毫秒常量（6 分钟，config.example）",
      "1200000": "毫秒常量（20 分钟，config.example）",
      "3000000": "毫秒常量（50 分钟，config.example）",
      "8388608": "字节数（8 MiB，config.example）",
      "64000000": "字节数（64 MB，config.example）",
      "12345678": "README 里的示例 QQ（private:12345678），不是真实账号",
      "123456": "文档里的示例群号/示例值",
      "101368": "CHANGELOG 里的示例进程 pid",
      "9887096": "CHANGELOG 里的短提交号",
      "5779317": "CHANGELOG 里的短提交号",
      "9038753": "scripts/fixtures 的 KonoAsset 商品号（不是群号）",
      "9013048": "docs/api-contract-files 里的 KonoAsset 商品号（不是群号）",
      "6538026": "scripts/fixtures 的 KonoAsset 商品号（不是群号）",
      "6082686": "scripts/fixtures 的 KonoAsset 商品号（不是群号）",
      "110400": "文档里的示例进程 pid",
      "118188": "文档里的示例进程 pid",
      "90000000": "文档里的示例毫秒数",
      "100012": "文档里的示例值",
      "302726": "文档里的示例 token 计数",
      "229142": "文档里的示例 token 计数",
      "302200": "文档里的示例 token 计数",
      "234227": "文档里的示例 token 计数",
      "100001": "console-ui-contracts 测试夹具 id",
      "100002": "console-ui-contracts 测试夹具 id",
      "100003": "console-ui-contracts 测试夹具 id",
      "800001": "console-ui-contracts 测试夹具 id",
      "800002": "console-ui-contracts 测试夹具 id",
      "900001": "console-ui-contracts 测试夹具 id",
      "6137193": "booth 测试夹具商品号",
      "7527770": "booth 测试夹具商品号",
      "5334903": "booth 测试夹具商品号",
      "35877230": "booth 测试夹具商品号",
      "7657840": "booth 测试夹具商品号",
      "4706721": "booth 测试夹具商品号",
      "6176948": "booth 测试夹具商品号",
      "5359699": "booth 测试夹具商品号",
      "15097651": "booth 测试夹具商品号",
      "15097839": "booth 测试夹具商品号",
      "15097840": "booth 测试夹具商品号",
      "18766055": "booth 测试夹具商品号"
    },
    "allowPathMatches": [
      { "file": "src/bridge.js", "match": "C:\\Users\\", "why": "源码里的'本机路径识别'正则，不是真实路径" },
      { "file": "scripts/test-sensitive.mjs", "match": "/home/user/", "why": "敏感信息识别器的测试夹具（Unix 路径示例）" },
      { "file": "docs/state-egress-boundary.md", "match": "C:\\Users\\", "why": "文档在讲解脱敏规则本身，示例必须保留" },
      { "file": "scripts/delivery-manifest.json", "match": "/home/user/", "why": "清单自身的允许项（随包发布，内容就是规则本身）" }
    ],
    "stickerFields": {
      "note": "表情记录的字段级处理（用户 12:59 口径）。clear=清空；nickname=换 <群友>；groupNumber=群号换 <群号>；textRedact=过通用脱敏（路径/QQ/群号）；其余字段原样保留，否则表情发不出去。",
      "clear": ["collectedContext", "lastContext"],
      "nickname": ["collectedBy"],
      "groupNumber": ["source", "collectedFrom"],
      "textRedact": ["desc", "localNote", "tags", "usage"]
    }
  },
  "pending": {}
}
